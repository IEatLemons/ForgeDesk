{
  "name": "forgedesk",
  "version": "1.3.1",
  "description": "Local-first project management console for repositories, environments, deployments, and AI reports.",
  "license": "MIT",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.3.0",
  "bin": {
    "forgedesk": "out/main/cli.js"
  },
  "type": "module",
  "scripts": {
    "prototype": "vite --config vite.prototype.config.ts",
    "prototype:build": "vite build --config vite.prototype.config.ts",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "build:menu-bar-helper": "node scripts/build-menu-bar-helper.mjs",
    "dev": "node scripts/build-menu-bar-helper.mjs && node scripts/rebuild-native.mjs && electron-vite dev",
    "build": "node scripts/build-menu-bar-helper.mjs && node scripts/rebuild-native.mjs && tsc --noEmit && electron-vite build",
    "build:quick": "node scripts/quick-build.mjs",
    "package:android": "node scripts/build-android.mjs",
    "package:mac": "node scripts/package-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "publish:github": "node scripts/trigger-github-release.mjs",
    "package:mac:legacy": "node scripts/package-mac.mjs",
    "preview": "node scripts/build-menu-bar-helper.mjs && node scripts/rebuild-native.mjs && electron-vite preview",
    "test": "node scripts/run-tests.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "better-sqlite3": "13.0.3",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "mysql2": "^3.23.1",
    "node-pty": "^1.0.0",
    "openid-client": "^6.8.8",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@electron/rebuild": "4.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.22.5",
    "dayjs": "1.11.21",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "app.forgedesk.desktop",
    "productName": "ForgeDesk",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/.cache{,/**/*}",
      "!**/node_modules/.ignored_*{,/**/*}",
      "!**/node_modules/.pnpm/electron@*/**/*",
      "!**/node_modules/.vite{,/**/*}",
      "!**/node_modules/electron{,/**/*}",
      "!**/node_modules/electron-builder{,/**/*}",
      "!**/node_modules/electron-vite{,/**/*}",
      "!**/node_modules/typescript{,/**/*}",
      "!**/node_modules/vite{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "resources/forgedesk.png",
        "to": "forgedesk.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": true,
    "afterSign": "scripts/after-sign.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/forgedesk.icns",
      "x64ArchFiles": "**/node_modules/{better-sqlite3,node-pty}/prebuilds/**/*",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/MenuBarHelper",
          "to": "MenuBarHelper"
        }
      ]
    },
    "win": {
      "icon": "resources/forgedesk.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/forgedesk.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IEatLemons",
        "repo": "ForgeDesk",
        "releaseType": "release"
      }
    ]
  }
}
